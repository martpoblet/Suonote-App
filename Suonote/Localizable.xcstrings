            "value": "Se borrará el audio grabado hasta ahora."
          }
        }
      }
    },
    "The backbone of modern pop — bright, singable, endlessly reusable.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La columna del pop moderno: brillante, cantable, reutilizable hasta el infinito."
          }
        }
      }
    },
