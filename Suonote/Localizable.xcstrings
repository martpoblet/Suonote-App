      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Axis"
          }
        }
      }
    },
    "The Axis’ darker twin — brooding, anthemic, cinematic.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El gemelo oscuro del Axis: melancólico, épico, cinematográfico."
          }
        }
      }
    },
    "The audio file will be removed. This can't be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará el archivo de audio. No se puede deshacer."
          }
